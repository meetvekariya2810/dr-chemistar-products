# ---------------------------------------------------------------------------
# Frontend -> API
# ---------------------------------------------------------------------------
# Leave UNSET for local development. The Vite dev server proxies /api to
# http://localhost:$PORT (see vite.config.ts), so the frontend uses same-origin
# relative URLs and works on whatever port Vite ends up on.
#
# Set it ONLY when the API is deployed on a different origin than the site.
# Its value is baked into the production bundle at build time, so it must never
# be a localhost URL in a deployed build.
# VITE_API_URL=https://your-api-host.example.com

# Optional: override the dev proxy target if the backend runs elsewhere.
# VITE_DEV_API_TARGET=http://localhost:5001

# ---------------------------------------------------------------------------
# Backend (server/) - these are NEVER sent to the browser
# ---------------------------------------------------------------------------
# Falls back to the local JSON store (server/data/*.json) if unreachable.
MONGO_URI=mongodb://127.0.0.1:27017/dr_chemist_agro

# Port the Express API listens on; the Vite dev proxy follows this value.
PORT=5001

# ---------------------------------------------------------------------------
# Admin CMS authentication (server/ only - NEVER prefix these with VITE_)
# ---------------------------------------------------------------------------
# Signs the admin session token. If unset the server generates a random secret
# at boot, so every restart signs admins out. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_TTL=8h

# CMS login. ADMIN_PASSWORD is the plaintext fallback for local development.
# In production set ADMIN_PASSWORD_HASH instead and leave ADMIN_PASSWORD unset:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" "yourPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=$2a$10$...

# Role for the single built-in account above: director | admin | staff.
# Defaults to director so the owner keeps full access to the farmer database.
#   director - view/edit/delete farmers + Excel & PDF export
#   admin    - view/edit farmers, NO delete, NO export
#   staff    - CMS access only, NO farmer data at all
# ADMIN_ROLE=director

# Several CMS accounts instead of one. When set, this REPLACES the single
# account above. passwordHash is a bcrypt hash (see the command above).
# ADMIN_ACCOUNTS=[{"username":"director","passwordHash":"$2a$10$...","role":"director"},{"username":"office","passwordHash":"$2a$10$...","role":"staff"}]

# Public farmer registrations allowed per IP per 15 minutes (default 12).
# Raise it where many farmers register from one shared connection.
# FARMER_REGISTER_RATE_LIMIT=12

# Comma-separated site origins allowed to call this API from a browser.
# Leave unset locally (the Vite proxy makes every request same-origin).
# ALLOWED_ORIGINS=https://your-site.vercel.app,https://www.your-domain.com

# Include error stacks in API responses. Never enable in production.
# DEBUG_ERRORS=false

# ---------------------------------------------------------------------------
# Optional: hide the website enquiry form
# ---------------------------------------------------------------------------
# Only set this when the form is deliberately switched off. When unset, the
# form always submits to the API and reports the real result - it must never
# claim "submission is not available" while a backend is configured.
# VITE_DISABLE_ENQUIRY_FORM=true
